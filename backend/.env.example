# ============================================================
# RAG 系统后端环境配置模板
# 复制为 .env 后按需修改。切勿将真实密钥提交到版本库。
# ============================================================

# ---------- 应用 ----------
APP_NAME="RAG 知识库系统"
APP_ENV=dev                       # dev | test | prod
DEBUG=true
API_V1_PREFIX=/api/v1
# 前端地址，用于 CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------- 安全 ----------
# 生产必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-please-use-a-random-48-bytes-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_MAX_FAIL=5                  # 连续失败次数上限
LOGIN_LOCK_SECONDS=900            # 锁定时长

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rag
MYSQL_PASSWORD=rag_pass
MYSQL_DB=rag
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_ECHO=false
# 连接失败时是否仍启动（dev 下方便先跑通接口）
MYSQL_ALLOW_STARTUP_WITHOUT_DB=true

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_DB=1
CELERY_BACKEND_DB=2

# ---------- Milvus ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
# 与百炼 text-embedding-v4 对齐，一旦入库禁止修改
MILVUS_VECTOR_DIM=1024

# ---------- 对象存储 MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-docs
MINIO_SECURE=false

# ---------- 模型：Embedding / Rerank（阿里云百炼） ----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10           # 百炼单次上限
EMBEDDING_CONCURRENCY=5
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2

# ---------- 模型：对话（DeepSeek / MiMo 可切换） ----------
DEFAULT_CHAT_PROVIDER=deepseek    # deepseek | mimo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=

# ---------- 检索参数默认值（后台可覆盖） ----------
RETRIEVE_TOP_K=30                 # 召回候选数
RERANK_TOP_N=8                    # 精排后保留数
SCORE_THRESHOLD=0.2
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---------- 上传限制 ----------
MAX_FILE_SIZE_MB=200
MAX_KB_TOTAL_MB=1024
ALLOWED_EXTENSIONS=["pdf","docx","doc","md","txt","xlsx","xls","csv"]

# ---------- 可观测 ----------
LOG_LEVEL=INFO
LOG_JSON=false                    # 生产置 true
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
